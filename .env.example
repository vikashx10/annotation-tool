# Flask
SECRET_KEY=change-me-in-production

# Supabase / PostgreSQL
DATABASE_URL=postgresql://postgres:<password>@<host>:<port>/<dbname>

# AWS / S3 credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# Optional: set for MinIO or other S3-compatible endpoints
# AWS_ENDPOINT_URL=http://localhost:9000

# Gemini model-review via OpenRouter (Junior OA "Model Review" flow). Leave unset to disable.
OPENROUTER_API_KEY=sk-or-...
# GEMINI_MODEL=google/gemini-3.1-pro-preview
# Sub-directory (next to each image) for Gemini's re-annotation labels.
# MODEL_LABEL_DIR=model_review

# Seed users on startup (JSON array). Existing usernames are skipped.
# Roles: admin | oa | annotator
USER_CONFIG='[
    {"username":"admin1","password":"AdminPass@123","role":"admin"},
    {"username":"oa1","password":"OaPass@123","role":"oa"},
    {"username":"annotator1","password":"AnnotatorPass@123","role":"annotator"}
]'
